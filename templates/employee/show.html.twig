{% extends 'base.html.twig' %}
{% block body %}
<a class="back-link" href="{{ path('timers') }}">← Back to timers</a>
<div class="employee-page-heading"><div class="employee-identity employee-profile"><span class="employee-avatar" aria-hidden="true">{{ employee.firstName|first }}{{ employee.lastName|first }}</span><div><h1>{{ employee.fullName }}</h1><p>{{ employee.position|title }} · {{ employee.department|title }}</p></div></div><div class="employee-total"><span>Tracked in period</span><strong>{{ total }}</strong></div></div>
<form method="get" class="period-filter" data-controller="period"><label>Period<select name="preset" data-period-target="preset" data-action="change->period#render"><option value="today">Today</option><option value="last7" {{ preset=='last7'?'selected' }}>Last 7 days</option><option value="month" {{ preset=='month'?'selected' }}>Last month</option><option value="custom" {{ preset=='custom'?'selected' }}>Custom</option></select></label><label data-period-target="dates" {{ preset!='custom'?'hidden' }}>From<input type="date" name="from" value="{{ from|date('Y-m-d') }}"></label><label data-period-target="dates" {{ preset!='custom'?'hidden' }}>To<input type="date" name="to" value="{{ to|date_modify('-1 day')|date('Y-m-d') }}"></label><button class="button" type="submit">Apply period</button></form>
<div class="records-heading"><div><h2>Time records</h2><p>{{ from|date('M j, Y') }} – {{ to|date_modify('-1 day')|date('M j, Y') }}</p></div><span>Calculated at {{ now|date('H:i:s','Asia/Aqtau') }}</span></div>
{% if report.details %}<div class="time-record-list">{% for item in report.details %}<article class="time-record-row"><div class="record-task"><strong>{{ item.record.description }}</strong>{% if item.record.running %}<span class="running-badge">Running</span>{% endif %}</div><div class="record-times"><span><small>Started</small>{{ item.record.startedAt|date('M j, H:i','Asia/Aqtau') }}</span><span><small>Ended</small>{{ item.record.endedAt ? item.record.endedAt|date('M j, H:i','Asia/Aqtau') : 'Still running' }}</span><strong>{{ (item.seconds/3600)|round(0,'floor') }}h {{ ((item.seconds%3600)/60)|round(0,'floor') }}m</strong></div></article>{% endfor %}</div>{% else %}<div class="empty"><strong>0h 00m</strong><p>No time records in this period.</p></div>{% endif %}
{% endblock %}
