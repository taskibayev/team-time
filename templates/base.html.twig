<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#172033"><title>TeamTime</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="{{ asset('styles/app.css') }}">{{ importmap('app') }}</head><body><header><a class="brand" href="{{ path('timers') }}">TeamTime</a><nav><a href="{{ path('timers') }}">Timers</a><a href="{{ path('reports') }}">Reports</a></nav></header><main>{% for message in app.flashes('error') %}<div class="alert">{{ message }}</div>{% endfor %}{% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}{% block body %}{% endblock %}</main></body></html>
